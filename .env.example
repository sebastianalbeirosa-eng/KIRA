# ================================================================
# KIRA - ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env)
# ================================================================
# Copiá este archivo con el nombre ".env" en la misma carpeta raíz
# y completá con los valores correspondientes de tu entorno.
# ================================================================

# --- PUERTO DE LA APLICACIÓN ---
PUERTO=3000

# --- SEGURIDAD Y SESIONES ---
# Clave secreta para firmar tokens de sesión seguros (escribí una frase larga y difícil de adivinar)
CLAVE_SECRETA_TOKEN=KiraPlantaIndustrialSuperSecreta2026!

# --- BASE DE DATOS MICROSOFT SQL SERVER ---
# Datos proporcionados por el equipo de IT de la empresa:
SQL_SERVIDOR=localhost
SQL_PUERTO=1433
SQL_BASE_DATOS=KIRA_PLANTA
SQL_USUARIO=sa
SQL_PASSWORD=TuPasswordSeguro123!
# Encriptar conexión (true para servidores remotos/Azure, false si es red local interna sin certificado SSL)
SQL_ENCRIPTADO=false
# Confiar en el certificado del servidor (recomendado 'true' en redes internas)
SQL_CONFIAR_CERTIFICADO=true

# --- ASISTENTE DE INTELIGENCIA ARTIFICIAL (GEMINI) ---
# Clave de API de Google Gemini (opcional, si se utiliza el módulo de IA)
GEMINI_API_KEY=
